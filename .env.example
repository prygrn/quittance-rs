# Identité du bailleur, reprise sur chaque quittance
LANDLORD_NAME="Prénom Nom"
LANDLORD_ADDRESS="1 rue Exemple, 75000 Paris"
LANDLORD_EMAIL="bailleur@example.com"

# Image de signature (PNG ou JPEG)
SIGNATURE_PATH="/chemin/vers/signature.png"

# Binaire Chromium ou Chrome utilisé pour générer le PDF
CHROME_PATH="/usr/bin/google-chrome"

# Serveur d'envoi
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USERNAME="bailleur@example.com"
# Mot de passe pris tel quel : les espaces en début et en fin ne sont pas supprimés.
SMTP_PASSWORD="change-me"

# Chiffrement SMTP : starttls (défaut), tls ou none.
# none est réservé à un serveur local (localhost, 127.0.0.1 ou ::1), comme Mailpit en test ;
# SMTP_USERNAME et SMTP_PASSWORD y sont alors optionnels et ne sont jamais transmis.
SMTP_SECURITY="starttls"
