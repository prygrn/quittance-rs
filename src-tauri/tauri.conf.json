{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Quittance",
  "version": "0.1.0",
  "identifier": "com.github.prygrn.quittance-rs",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Quittance",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../crates/quittance-signature/assets/DejaVuSans-LICENSE.txt": "licenses/DejaVuSans-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
