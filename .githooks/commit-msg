#!/usr/bin/env bash
# Vérifie le format du message (règles git du kernel), puis la qualité et les tests.
# Un commit de type test peut contenir des tests rouges : c'est l'étape test-first.
set -euo pipefail

readonly MESSAGE_FILE="$1"
readonly HEADER_PATTERN='^(feat|fix|test|refactor|chore|docs)\([a-z0-9-]+\): [a-z0-9][^A-Z]*[^.]$'
readonly BREAKING_FOOTER_PATTERN='^BREAKING CHANGE: '

message_lines=$(grep -v '^#' "$MESSAGE_FILE" | sed '/^[[:space:]]*$/d')
header=$(head -n 1 <<<"$message_lines")
extra_lines=$(tail -n +2 <<<"$message_lines")

if ! [[ "$header" =~ $HEADER_PATTERN ]]; then
  echo "commit-msg: en-tête invalide, format attendu <type>(<scope>): <description en minuscules, sans point final>" >&2
  exit 1
fi

if [[ -n "$extra_lines" ]] && ! grep -qE "$BREAKING_FOOTER_PATTERN" <<<"$extra_lines"; then
  echo "commit-msg: ni corps ni footer autorisés, sauf un footer BREAKING CHANGE" >&2
  exit 1
fi

make quality

if [[ "$header" =~ ^test\( ]]; then
  make test-unit || echo "commit-msg: tests rouges tolérés pour un commit de type test" >&2
else
  make test-unit
fi
